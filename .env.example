# ===================================================
# STUDENT MANAGEMENT - ENVIRONMENT CONFIGURATION
# ===================================================

# 1. Nguồn dữ liệu (DATA_SOURCE: "supabase" | "local")
# - supabase: Kết nối cơ sở dữ liệu PostgreSQL thông qua Supabase Cloud (Khuyến nghị cho Production)
# - local: Lưu trữ in-memory cục bộ (phù hợp test offline, phát triển nhanh)
DATA_SOURCE=supabase

# 2. Cấu hình Supabase Cloud (Bắt buộc khi DATA_SOURCE=supabase)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_SERVICE_ROLE_KEY: Khóa bí mật dùng ở server-side Next.js để bypass RLS
# TUYỆT ĐỐI KHÔNG để lộ ra client-side hoặc commit lên git repository
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Khóa công khai anon cho client-side Supabase
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Cấu hình ứng dụng chung
NEXT_PUBLIC_APP_NAME="Student Management System"
NEXT_PUBLIC_APP_ENV="production"

# 4. Tính năng Dev / Debug
# Bật/tắt QuickRoleSwitcher (mặc định chỉ bật ở NODE_ENV=development)
NEXT_PUBLIC_ENABLE_DEV_ROLE_SWITCHER=false

# 5. Ký cookie phiên đăng nhập (Bắt buộc khi DATA_SOURCE=supabase)
# Tối thiểu 32 ký tự. Thiếu hoặc ngắn hơn -> login trả 500 thay vì phát cookie
# không ký được. Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your-session-secret-at-least-32-chars
